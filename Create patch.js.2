<!DOCTYPE html>
<html lang="fa" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0f172a"><meta name="apple-mobile-web-app-capable" content="yes"><link rel="manifest" href="manifest.json"><link rel="apple-touch-icon" href="icon-192.png"><title>فلش‌کارت</title></head>
<body style="background:#0f172a;color:#e2e8f0;font-family:Tahoma,Arial;padding:24px;text-align:center"><div id="m">⏳ در حال بارگذاری فلش‌کارت...</div>
<script>
(function(){
var SRC='app-v47.html';
function fail(t){document.getElementById('m').textContent=t}
function get(u){return fetch(u,{cache:'no-store'}).then(function(r){if(!r.ok)throw new Error(u+' → HTTP '+r.status);return r.text()})}
Promise.all([get(SRC),get('patch.js')]).then(function(a){
  var src=a[0],patch=a[1],miss=[];
  function rep(x,y){if(src.indexOf(x)<0){miss.push(x.slice(0,40));return}src=src.split(x).join(y)}
  src=src.replace(/<title>[^<]*<\/title>/,'<title>فلش‌کارت</title>');
  src=src.replace('<head>','<head><link rel="manifest" href="manifest.json"><link rel="apple-touch-icon" href="icon-192.png">');
  rep("$('fileBackup').addEventListener('change',function(e){","$('fileBackup').addEventListener('change',function(e){if(window.importBackupV50)return window.importBackupV50(e);");
  rep('id="fileBackup" accept=".json"','id="fileBackup"');
  var n=src.length;src=src.replace(/\n\s*await openIDB\(\);/,'');if(src.length===n)miss.push('openIDB');
  rep('var ok=load();','await openIDB();var ok=await loadAll();');
  rep('setInterval(save,15000);','');
  rep('version:49,exportedAt','version:50,exportedAt');
  rep('/* ========== INIT ========== */',patch+'\n/* ========== INIT ========== */');
  try{sessionStorage.setItem('v50miss',JSON.stringify(miss))}catch(e){}
  document.open();document.write(src);document.close();
}).catch(function(e){fail('❌ نتونستم فایل‌ها رو بخونم ('+e.message+'). مطمئن شو app-v47.html و patch.js کنار همین فایل آپلود شدن.')});
})();
</script></body></html>
