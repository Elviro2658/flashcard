<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>فلش‌کارت</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: system-ui, Tahoma, sans-serif;
  background: #f5f5f7;
  color: #1a1a1a;
  min-height: 100vh;
}
.app { max-width: 680px; margin: 40px auto; padding: 0 16px; }
.header { display: flex; justify-content: space-between; margin-bottom: 24px; }
.title { margin: 0; font-size: 1.5rem; }
.counter { color: #666; font-size: 0.9rem; }
.card-box {
  background: #fff; border-radius: 16px; padding: 32px 24px;
  min-height: 240px; display: flex; flex-direction: column;
  justify-content: center; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
.question { font-size: 1.4rem; font-weight: 600; margin: 0 0 20px; }
.answer { font-size: 1.2rem; color: #333; margin: 0 0 24px; }
button {
  font-family: inherit; font-size: 1rem; padding: 10px 18px;
  border-radius: 10px; border: 1px solid #d0d0d5; background: #fff;
  cursor: pointer; transition: all 0.15s;
}
button:hover { background: #f0f0f5; }
.btn-wrong   { background: #ffd6d6; border-color: #f0a0a0; }
.btn-hard    { background: #fff0c2; border-color: #e8c860; }
.btn-correct { background: #d1f4d1; border-color: #8fd88f; }
.btn-easy    { background: #d6e8ff; border-color: #90b8f0; }
.grade-row { display: flex; gap: 8px; flex-wrap: wrap; }
.empty { text-align: center; padding: 60px 20px; color: #666; }
</style>
</head>
<body>
<div class="app">
  <div class="header">
    <h1 class="title" id="topicName">فلش‌کارت</h1>
    <span class="counter" id="counter"></span>
  </div>
  <div id="cardArea"></div>
</div>

<script>
// ========== دیتا ==========
// اینو بعداً می‌تونی ویرایش کنی و کارت اضافه کنی
const deck = {
  topic: "نمونه",
  subtopics: [
    {
      name: "مبحث اول",
      cards: [
        { id: "c1", q: "پایتخت ایران؟", a: "تهران" },
        { id: "c2", q: "۲ + ۲ چند است؟", a: "۴" },
        { id: "c3", q: "بزرگ‌ترین سیاره منظومه شمسی؟", a: "مشتری" },
        { id: "c4", q: "آب از چه چیزی ساخته شده؟", a: "H₂O" },
        { id: "c5", q: "سال میلادی چند ماه دارد؟", a: "۱۲ ماه" }
      ]
    }
  ]
};

// ========== الگوریتم SM-2 ==========
function review(stats, grade) {
  const now = new Date();
  let { ease, interval, reviews, correct } = stats;

  if (grade < 3) {
    interval = 0;
    reviews += 1;
  } else {
    if (interval === 0) interval = 1;
    else if (interval === 1) interval = 6;
    else interval = Math.round(interval * ease);

    ease = ease + (0.1 - (5 - grade) * (0.08 + (5 - grade) * 0.02));
    if (ease < 1.3) ease = 1.3;

    reviews += 1;
    correct += 1;
  }

  const due = new Date(now);
  due.setDate(due.getDate() + interval);

  return {
    ease, interval, reviews, correct,
    due: due.toISOString(),
    lastSeen: now.toISOString()
  };
}

function isDue(stats) {
  if (!stats.due) return true;
  return new Date(stats.due) <= new Date();
}

function defaultStats() {
  return { reviews: 0, correct: 0, ease: 2.5, interval: 0, due: null, lastSeen: null };
}

// ========== ذخیره‌سازی ==========
const KEY = "flashcards.stats.v1";

function loadStats() {
  try { return JSON.parse(localStorage.getItem(KEY) || "{}"); }
  catch { return {}; }
}
function saveStats(map) {
  localStorage.setItem(KEY, JSON.stringify(map));
}

// ========== وضعیت برنامه ==========
let queue = [];
let current = null;
let showAnswer = false;

// ========== شروع ==========
function start() {
  document.getElementById("topicName").textContent = deck.topic;
  const stats = loadStats();
  const all = deck.subtopics.flatMap(s => s.cards);

  queue = all.filter(c => {
    const st = stats[c.id] || defaultStats();
    return isDue(st);
  });

  current = queue[0] || null;
  render();
}

// ========== نمایش ==========
function render() {
  const area = document.getElementById("cardArea");
  const counter = document.getElementById("counter");
  counter.textContent = "باقی‌مانده: " + queue.length;

  if (!current) {
    area.innerHTML = '<div class="empty"><h2>🎉 همه کارت‌ها مرور شدن!</h2><p>فردا برگرد.</p></div>';
    return;
  }

  let html = '<div class="card-box">';
  html += '<p class="question">' + current.q + '</p>';

  if (showAnswer) {
    html += '<p class="answer">' + current.a + '</p>';
    html += '<div class="grade-row">';
    html += '<button class="btn-wrong"   onclick="grade(0)">غلط</button>';
    html += '<button class="btn-hard"    onclick="grade(3)">سخت</button>';
    html += '<button class="btn-correct" onclick="grade(4)">خوب</button>';
    html += '<button class="btn-easy"    onclick="grade(5)">آسان</button>';
    html += '</div>';
  } else {
    html += '<button onclick="reveal()">نمایش جواب</button>';
  }

  html += '</div>';
  area.innerHTML = html;
}

function reveal() {
  showAnswer = true;
  render();
}

function grade(g) {
  if (!current) return;

  const stats = loadStats();
  const st = stats[current.id] || defaultStats();
  const newSt = review(st, g);
  stats[current.id] = newSt;
  saveStats(stats);

  queue = queue.slice(1);
  current = queue[0] || null;
  showAnswer = false;
  render();
}

// ========== اجرا ==========
start();
</script>
</body>
</html>
